// Tests for the state-transition relation (tx.nr / batch.nr) - the layer the
// security remediation's guards actually live in. Witness data (Merkle paths,
// signatures) is generated by the harness: `cargo run -p harness --
// noir-tx-vectors` regenerates tx_vectors.nr; scripts/check_vectors.sh (CI)
// fails if the checked-in copy drifts.
//
// Negative tests are constructed so every OTHER constraint is satisfied - the
// named guard is the only thing standing between the witness and a valid
// proof (see the per-fixture docs in tx_vectors.nr).
use crate::batch::batch;
use crate::tx::{apply_deposit, apply_tx};
use crate::tx_vectors;

// --- The full relation: five public inputs pinned to harness values --------

#[test]
fn batch_2x2_replays_and_pins_all_five_public_inputs() {
    let (pis, deps, txs) = tx_vectors::batch_a();
    batch::<2, 2>(pis[0], pis[1], pis[2], pis[3], pis[4], deps, txs);
}

#[test(should_fail)]
fn batch_rejects_wrong_new_root() {
    let (pis, deps, txs) = tx_vectors::batch_a();
    batch::<2, 2>(pis[0], pis[1] + 1, pis[2], pis[3], pis[4], deps, txs);
}

#[test(should_fail)]
fn batch_rejects_wrong_deposit_hash() {
    let (pis, deps, txs) = tx_vectors::batch_a();
    batch::<2, 2>(pis[0], pis[1], pis[2] + 1, pis[3], pis[4], deps, txs);
}

#[test(should_fail)]
fn batch_rejects_wrong_withdraw_hash() {
    let (pis, deps, txs) = tx_vectors::batch_a();
    batch::<2, 2>(pis[0], pis[1], pis[2], pis[3] + 1, pis[4], deps, txs);
}

#[test(should_fail)]
fn batch_rejects_wrong_da_commitment() {
    let (pis, deps, txs) = tx_vectors::batch_a();
    batch::<2, 2>(pis[0], pis[1], pis[2], pis[3], pis[4] + 1, deps, txs);
}

// --- apply_tx guards --------------------------------------------------------

#[test(should_fail)]
fn overdraft_fails_range_check() {
    let (root, w) = tx_vectors::overdraft();
    let _ = apply_tx(root, 0, 0, w);
}

#[test(should_fail)]
fn signature_binds_amount() {
    let (root, w) = tx_vectors::amount_not_signed();
    let _ = apply_tx(root, 0, 0, w);
}

#[test(should_fail)]
fn zero_amount_spend_rejected() {
    let (root, w) = tx_vectors::zero_amount();
    let _ = apply_tx(root, 0, 0, w);
}

#[test(should_fail)]
fn future_nonce_fails_inclusion() {
    let (root, w) = tx_vectors::future_nonce();
    let _ = apply_tx(root, 0, 0, w);
}

#[test(should_fail)]
fn padding_key_cannot_spend() {
    let (root, w) = tx_vectors::pad_spend();
    let _ = apply_tx(root, 0, 0, w);
}

#[test(should_fail)]
fn odd_y_sender_rejected() {
    let (root, w) = tx_vectors::odd_y_sender();
    let _ = apply_tx(root, 0, 0, w);
}

#[test(should_fail)]
fn padding_key_cannot_receive() {
    let (root, w) = tx_vectors::transfer_to_pad();
    let _ = apply_tx(root, 0, 0, w);
}

// --- apply_deposit guards ---------------------------------------------------

#[test(should_fail)]
fn ghost_state_deposit_rejected() {
    let (root, w) = tx_vectors::ghost_deposit();
    let _ = apply_deposit(root, 0, w);
}

#[test(should_fail)]
fn deposit_pk_mismatch_rejected() {
    let (root, w) = tx_vectors::deposit_pk_mismatch();
    let _ = apply_deposit(root, 0, w);
}

#[test(should_fail)]
fn deposit_overflow_rejected() {
    let (root, w) = tx_vectors::deposit_overflow();
    let _ = apply_deposit(root, 0, w);
}

// --- Inactive entries are identities ----------------------------------------

#[test]
fn inactive_entries_move_nothing() {
    let (root, d, t) = tx_vectors::inactive_entries();
    let (r1, dep_acc) = apply_deposit(root, 42, d);
    assert(r1 == root);
    assert(dep_acc == 42);
    let (r2, wd_acc, da_acc) = apply_tx(root, 43, 44, t);
    assert(r2 == root);
    assert(wd_acc == 43);
    assert(da_acc == 44);
}
